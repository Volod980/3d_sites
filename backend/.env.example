PORT=3000
NODE_ENV=development
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Google Gemini AI API Key (безкоштовно на https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Google Maps Places API Key (інструкція: /GOOGLE_MAPS_API_SETUP.md)
# Перші $200/місяць безкоштовно (~28,000 запитів)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
